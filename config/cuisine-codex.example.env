# Codex CLI handoff settings. This file contains no API key and is not loaded automatically.
# The model value below is confirmed for the current pilot; update it when the Codex session model changes.
CODEX_CLI_VERSION="codex-cli-0.146.0"
CODEX_MODEL_VERSION="GPT 5.6 Luna Max"
CODEX_AGENT_PROMPT_VERSION="cuisine-codex-agent-prompt-v1"
CODEX_AI_BATCH_SIZE="20"
CODEX_WEB_BATCH_SIZE="5"
CODEX_OUTPUT_ROOT="/private/tmp/jazamila-codex-runs"

# AI batches must not use network. Web batches require an explicit, separate
# Codex session with browsing/network permission and source evidence handling.
CODEX_AI_NETWORK_POLICY="disabled"
CODEX_WEB_NETWORK_POLICY="explicit-web-only"
