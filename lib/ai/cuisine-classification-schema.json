{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jazamila.local/schemas/cuisine-classification-v1.json",
  "title": "JAZAMILA restaurant cuisine classification",
  "description": "Structured AI-only classification output. This output is never a database write by itself.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "restaurantId": {
      "type": "integer",
      "minimum": 1
    },
    "inputFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "selectedCuisineTypeId": {
      "anyOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "null" }
      ]
    },
    "selectedCuisineTypeName": {
      "anyOf": [
        { "type": "string", "minLength": 1, "maxLength": 80 },
        { "type": "null" }
      ]
    },
    "proposedNewCuisineType": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 80 },
            "normalizedName": { "type": "string", "minLength": 1, "maxLength": 80 },
            "reason": { "type": "string", "minLength": 1, "maxLength": 280 }
          },
          "required": ["name", "normalizedName", "reason"]
        },
        { "type": "null" }
      ]
    },
    "keptTags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 80 },
      "uniqueItems": true
    },
    "removedTags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 80 },
      "uniqueItems": true
    },
    "addedTags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 80 },
      "uniqueItems": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needsWebResearch": {
      "type": "boolean"
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "EXPLICIT_CUISINE_TAG",
          "RESTAURANT_NAME_SUPPORTS_TYPE",
          "SOURCE_SUPPORTS_TYPE",
          "LEGACY_FOODTYPE_SUPPORTS_TYPE",
          "AUXILIARY_TAG_ONLY",
          "CONFLICTING_EVIDENCE",
          "INSUFFICIENT_EVIDENCE",
          "CANDIDATE_TYPE_REQUIRED",
          "WEB_RESEARCH_REQUIRED",
          "BRANCH_IDENTITY_UNCERTAIN",
          "TAG_CLEANUP_SUPPORTED",
          "TAG_SYNONYM_NORMALIZED",
          "NO_NEW_MARKETING_TAG",
          "AI_REFUSAL",
          "PROVIDER_OUTPUT_INVALID"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "shortReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    }
  },
  "required": [
    "restaurantId",
    "inputFingerprint",
    "selectedCuisineTypeId",
    "selectedCuisineTypeName",
    "proposedNewCuisineType",
    "keptTags",
    "removedTags",
    "addedTags",
    "confidence",
    "needsWebResearch",
    "reasonCodes",
    "shortReason"
  ],
  "oneOf": [
    {
      "properties": {
        "selectedCuisineTypeId": { "type": "integer", "minimum": 1 },
        "selectedCuisineTypeName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "proposedNewCuisineType": { "type": "null" }
      }
    },
    {
      "properties": {
        "selectedCuisineTypeId": { "type": "null" },
        "selectedCuisineTypeName": { "type": "null" },
        "proposedNewCuisineType": { "type": "object" }
      }
    },
    {
      "properties": {
        "selectedCuisineTypeId": { "type": "null" },
        "selectedCuisineTypeName": { "type": "null" },
        "proposedNewCuisineType": { "type": "null" }
      }
    }
  ]
}
