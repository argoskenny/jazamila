{
  "name": "jazamila",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "e2e": "npm run e2e:release",
    "e2e:prepare": "DATABASE_URL=file:./e2e.db node prisma/ensure-sqlite.cjs && DATABASE_URL=file:./e2e.db prisma db push --skip-generate && DATABASE_URL=file:./e2e.db node prisma/seed.cjs",
    "e2e:release": "npm run e2e:prepare && npm run build && playwright test --reporter=line",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_URL=${TEST_DATABASE_URL:-file:./test.db} node prisma/ensure-sqlite.cjs && DATABASE_URL=${TEST_DATABASE_URL:-file:./test.db} prisma db push --skip-generate && DATABASE_URL=${TEST_DATABASE_URL:-file:./test.db} node prisma/seed.cjs && DATABASE_URL=${TEST_DATABASE_URL:-file:./test.db} vitest run --no-file-parallelism",
    "db:generate": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma generate",
    "db:push": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma db push",
    "db:push:prod": "node prisma/ensure-sqlite.cjs && prisma db push",
    "db:seed": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} node prisma/seed.cjs",
    "db:seed:cuisine:dry": "node scripts/seed-cuisine-types.cjs --dry-run",
    "db:seed:cuisine": "node scripts/seed-cuisine-types.cjs --apply",
    "db:export:cuisine-types": "node scripts/export-cuisine-types.cjs",
    "db:setup": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} node prisma/ensure-sqlite.cjs && DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma db push && DATABASE_URL=${DATABASE_URL:-file:./dev.db} node prisma/seed.cjs",
    "db:import:legacy:dry": "node scripts/import-legacy-mysql-to-sqlite.cjs --dry-run",
    "db:import:legacy": "node scripts/import-legacy-mysql-to-sqlite.cjs",
    "db:import:res-data:dry": "node scripts/import-res-data-to-sqlite.cjs --dry-run",
    "db:import:res-data": "node scripts/import-res-data-to-sqlite.cjs",
    "db:classify:cuisine:dry": "node scripts/classify-cuisine-deterministic.cjs --dry-run",
    "db:classify:cuisine:unverified:dry": "node scripts/classify-cuisine-unverified-backup.cjs",
    "db:classify:cuisine:codex:autonomous:prepare": "node scripts/prepare-cuisine-autonomous-codex-handoffs.cjs",
    "db:classify:cuisine:ai:dry": "node scripts/prepare-cuisine-ai-classification.cjs --dry-run",
    "db:classify:cuisine:ai:run": "node scripts/run-cuisine-ai-classification.cjs",
    "db:classify:cuisine:web:dry": "node scripts/prepare-cuisine-web-research.cjs --dry-run",
    "db:classify:cuisine:web:run": "node scripts/run-cuisine-web-research.cjs",
    "db:classify:cuisine:codex:prepare": "node scripts/prepare-cuisine-codex-batch.cjs",
    "db:classify:cuisine:codex:validate": "node scripts/validate-cuisine-codex-output.cjs",
    "db:classify:cuisine:candidates:dry": "node scripts/review-cuisine-type-candidates.cjs",
    "db:classify:cuisine:audit:dry": "node scripts/audit-cuisine-conversion.cjs",
    "db:classify:cuisine:apply:dry": "node scripts/apply-cuisine-classification.cjs",
    "db:classify:cuisine:cleanup:dry": "node scripts/cleanup-cuisine-tags.cjs",
    "db:classify:cuisine:target:audit": "node scripts/audit-cuisine-target.cjs",
    "db:sync:res-data-lookups": "node scripts/sync-res-data-lookups.cjs --write",
    "db:check:res-data-lookups": "node scripts/sync-res-data-lookups.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "ajv": "^6.15.0",
    "mysql2": "^3.22.3",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "server-only": "^0.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.4.1",
    "playwright": "^1.60.0",
    "prisma": "^6.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "^8.5.15"
  }
}
